@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bp: <urn:samm:io.admin-shell.idta.batterypass.circularity:1.0.0#> .
@prefix : <urn:samm:io.catenax.battery.supplier_data_model.circularity:1.0.0#> .

:SupplierCircularity a samm:Aspect ;
   samm:preferredName "circularity for supplier data model"@en ;
   samm:preferredName "Zirkularität für das Lieferantendatenmodell"@de ;
   samm:description "Contains the circularity information of a supplied product (material, substance, mixture or component) as required from suppliers under the EU Battery Regulation: recycled content per material, renewable content share and safety measures. Supplier view of IDTA 02035-7; all properties are referenced as-is from the IDTA model."@en ;
   samm:description "Enthält die Zirkularitätsinformationen eines gelieferten Produkts (Stoff, Gemisch oder Komponente), wie sie von Lieferanten im Rahmen der EU-Batterieverordnung benötigt werden: Rezyklatanteile je Material, Anteil erneuerbarer Materialien und Sicherheitsmaßnahmen. Lieferantensicht auf IDTA 02035-7; alle Eigenschaften werden unverändert aus dem IDTA-Modell referenziert."@de ;
   samm:properties (
   [ samm:property bp:recycledContent; samm:payloadName "RecycledContentInformation" ]
   [ samm:property bp:renewableContent; samm:optional true; samm:payloadName "RenewableContent" ]
   [ samm:property bp:safetyMeasures; samm:optional true; samm:payloadName "SafetyMeasures" ]
   ) ;
   samm:operations ( ) ;
   samm:events ( ) ;
   samm:see <urn:samm:io.admin-shell.idta.batterypass.circularity:1.0.0> .

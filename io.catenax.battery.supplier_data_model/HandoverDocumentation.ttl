@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bp: <urn:samm:io.admin-shell.idta.batterypass.handover_documentation:1.0.0#> .
@prefix : <urn:samm:io.catenax.battery.supplier_data_model.handover_documentation:1.0.0#> .

:SupplierHandoverDocumentation a samm:Aspect ;
   samm:preferredName "handover documentation for supplier data model"@en ;
   samm:preferredName "Übergabe-Dokumentation für das Lieferantendatenmodell"@de ;
   samm:description "Contains the set of documents a supplier hands over together with the supplied product data (material, substance, mixture or component) under the EU Battery Regulation, described by VDI 2770 document metadata. Supplier view of IDTA 02035-2."@en ;
   samm:description "Enthält die Menge der Dokumente, die ein Lieferant zusammen mit den Daten des gelieferten Produkts (Stoff, Gemisch oder Komponente) im Rahmen der EU-Batterieverordnung übergibt, beschrieben mit VDI-2770-Dokumentmetadaten. Lieferantensicht auf IDTA 02035-2."@de ;
   samm:properties (
   [ samm:property bp:documents; samm:payloadName "Documents" ]
   ) ;
   samm:operations ( ) ;
   samm:events ( ) ;
   samm:see <urn:irdi:0173-1%2301-AHF578%23003> ;
   samm:see <urn:samm:io.admin-shell.idta.batterypass.handover_documentation:1.0.0> .

@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bp: <urn:samm:io.admin-shell.idta.batterypass.digital_nameplate:1.0.0#> .
@prefix tech: <urn:samm:io.admin-shell.idta.batterypass.technical_data:1.0.0#> .
@prefix : <urn:samm:io.catenax.battery.supplier_data_model.digital_nameplate:1.0.0#> .

:SupplierNameplate a samm:Aspect ;
   samm:preferredName "nameplate for supplier data model"@en ;
   samm:preferredName "Typenschild für das Lieferantendatenmodell"@de ;
   samm:description "Contains the general identification information of a supplied product (material, substance, mixture or component) and its manufacturer, as required from suppliers under the EU Battery Regulation. Supplier view of IDTA 02035-1; all properties are referenced as-is from the IDTA model."@en ;
   samm:description "Enthält die allgemeinen Identifikationsinformationen eines gelieferten Produkts (Stoff, Gemisch oder Komponente) und dessen Herstellers, wie sie von Lieferanten im Rahmen der EU-Batterieverordnung benötigt werden. Lieferantensicht auf IDTA 02035-1; alle Eigenschaften werden unverändert aus dem IDTA-Modell referenziert."@de ;
   samm:properties (
   [ samm:property bp:uriOfTheProduct; samm:payloadName "URIOfTheProduct" ]
   [ samm:property bp:serialNumber; samm:optional true; samm:payloadName "SerialNumber" ]
   [ samm:property tech:manufacturerIdentifier; samm:payloadName "ManufacturerIdentifier" ]
   [ samm:property bp:dateOfManufacture; samm:optional true; samm:payloadName "DateOfManufacture" ]
   [ samm:property bp:dateOfPuttingIntoService; samm:optional true; samm:payloadName "DateOfPuttingIntoService" ]
   [ samm:property bp:batteryStatus; samm:optional true; samm:payloadName "LifeCycleStage" ]
   [ samm:property bp:operatorIdentifier; samm:optional true; samm:payloadName "OperatorIdentifier" ]
   [ samm:property bp:manufacturerName; samm:payloadName "ManufacturerName" ]
   [ samm:property bp:uniqueFacilityIdentifier; samm:optional true; samm:payloadName "UniqueFacilityIdentifier" ]
   [ samm:property bp:addressInformation; samm:optional true; samm:payloadName "AddressInformation" ]
   [ samm:property bp:markings; samm:optional true; samm:payloadName "Markings" ]
   [ samm:property bp:euDeclarationOfConformity; samm:optional true; samm:payloadName "EUDeclarationOfConformity" ]
   [ samm:property bp:resultsOfTestReportsProvingCompliance; samm:optional true; samm:payloadName "ResultsOfTestReportsProvingCompliance" ]
   ) ;
   samm:operations ( ) ;
   samm:events ( ) ;
   samm:see <https://admin-shell.io/idta/nameplate/3/0/Nameplate> ;
   samm:see <urn:samm:io.admin-shell.idta.batterypass.digital_nameplate:1.0.0> .
